            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Start OpenOCD (GDLink)",
            "type": "process",
            "windows": {
                "command": "${workspaceFolder}/tools/xpack-openocd-0.11.0-3_windows/bin/openocd.exe",
                "args": [
                    "-f",
                    "${workspaceFolder}/MSDK/projects/cmake/output/openocd_gdlink.cfg"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/tools/xpack-openocd-0.11.0-3_linux/bin/openocd",
                "args": [
                    "-f",
                    "${workspaceFolder}/MSDK/projects/cmake/output/openocd_gdlink.cfg"
                ]
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Open On-Chip Debugger.*",
                    "endsPattern": "^.*Listening on port.*"
                }
            }
        },
        {
            "label": "Start OpenOCD (JLink)",
            "type": "process",
            "windows": {
                "command": "${workspaceFolder}/tools/xpack-openocd-0.11.0-3_windows/bin/openocd.exe",
                "args": [
                    "-f",
                    "${workspaceFolder}/MSDK/projects/cmake/output/openocd_jlink.cfg"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/tools/xpack-openocd-0.11.0-3_linux/bin/openocd",
                "args": [
                    "-f",
                    "${workspaceFolder}/MSDK/projects/cmake/output/openocd_jlink.cfg"
                ]
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Open On-Chip Debugger.*",
                    "endsPattern": "^.*Listening on port.*"
                }
            }
        },
        {
            "label": "Run Program (JLink)",
            "type": "process",
            "windows": {
                "command": "${workspaceFolder}/tools/xpack-openocd-0.11.0-3_windows/bin/openocd.exe",
                "args": [
                    "-f",
                    "${workspaceFolder}/MSDK/projects/cmake/output/openocd_jlink.cfg",
                    "-c",
                    "reset run",
                    "-c",
                    "shutdown"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/tools/xpack-openocd-0.11.0-3_linux/bin/openocd",
                "args": [
                    "-f",
                    "${workspaceFolder}/MSDK/projects/cmake/output/openocd_jlink.cfg",
                    "-c",
                    "reset run",
                    "-c",
                    "shutdown"
                ]
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Download Run (JLink)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build ALL",
                "Download ALL (JLink)",
                "Run Program (JLink)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Debug Serial Monitor (COM5 115200)",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/.vscode/serial-monitor.ps1",
                    "-Port",
                    "COM5",
                    "-BaudRate",
                    "115200"
                ]
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "UART Scan",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}/tools/official/GD32_Mass_Production_Tool/GD32MassProductionTool_CMD.exe",
                "args": [
                    "scan"
                ]
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
