            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Download MSDK (GDLink)",
            "type": "shell",
            "args": ["MSDK", "GDLink"],
            "windows": {
                "command": "${workspaceFolder}/.vscode/download.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/.vscode/download.sh"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Download MBL (GDLink)",
