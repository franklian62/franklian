{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MSDK",
            "type": "shell",
            "args": [
                "app",
                "msdk"
            ],
            "windows": {
                "command": "${workspaceFolder}/cmake_build.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/cmake_build.sh"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build MBL",
            "type": "shell",
            "args": [
                "app",
                "mbl"
            ],
            "windows": {
